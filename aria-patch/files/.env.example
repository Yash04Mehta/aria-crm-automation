# Get a free key at https://aistudio.google.com/apikey
# This key stays on the server. The browser only ever receives a short-lived token.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides
# LIVE_MODEL=gemini-3.8-live
# SUMMARY_MODEL=gemini-3.5-flash-lite
# AGENT_VOICE=Kore

# Optional: send every call's outcome to an automation webhook (e.g. n8n). Off when empty.
# CRM_WEBHOOK_URL=http://localhost:5678/webhook/aria-call
# CRM_WEBHOOK_SECRET=choose-a-long-random-string
